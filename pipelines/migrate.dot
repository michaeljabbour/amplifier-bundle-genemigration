// Gene-Migration — MIGRATION phase (the attractor loop).
//
// Consumes the dependency-SEQUENCED backlog produced by inventory.dot and migrates
// the app story-by-story from the SOURCE language to the TARGET language. Each loop
// rebuilds ONE user story idiomatically in the target — behavior fidelity proven by
// the story's own acceptance criteria (as target-language tests) AND a real-terminal
// forge check — then opens a PR. Earliest 'new' row = next in sequence.
//
// MIGRATION vs TRANSFER (how this differs from HGT/genetransfer): this is a
// whole-app rebuild with ONE source and ONE target. You DO study the source code
// deeply — behavior fidelity is the goal — but you re-implement IDIOMATICALLY in the
// target language; you never transliterate line-by-line, and the acceptance criteria
// (not the source's internals) are the oracle.
//
// ENGINE: attractor loop-pipeline. box = LLM agent; parallelogram = tool node routed
// on its last stdout line (EXACT match; non-zero exit leaves last_line stale — every
// gate ends `... && printf pass || printf fail`; never remove that idiom).
//
// PARAMS (UPPERCASE env vars, fail-loud; or run_pipeline params of the same name):
//   SOURCE_PATH  abs path to the source app (language A) — read-only reference
//   TARGET_PATH  abs path to the target repo (language B; story #1 scaffolds CI if new)
//   TARGET_KIND  python | rust | new:<lang>   (selects the gate stack; == CI)
//   FORGE_TOOL   abs path to amplifier-skill-forge/tools/forge.py
//   LEDGER_TOOL  abs path to this bundle's pipelines/ledger.py
//   BACKLOG      abs path to the sequenced backlog TSV (from the inventory phase)
//
// MODELS: claude-opus-4-8 on every LLM node (fable-5 refuses autonomous porting).

digraph gm_migrate {
    graph [
        goal="Migrate the app story-by-story, in the backlog's dependency sequence, from the source language to the target language. Behavior fidelity to the SOURCE is the goal; the story's ACCEPTANCE CRITERIA are the oracle. Study the source deeply but re-implement IDIOMATICALLY in the target — never transliterate. Gate every story on the target unit suite AND a real-terminal forge check that proves the acceptance criteria. One story per loop; one PR per story; never commit to a protected branch. Done when no 'new' rows remain.",
        default_fidelity="truncate",
        default_max_retry="3"
    ]

    start [shape=Mdiamond]

    // --- loop head: params present? stories left? (deterministic, fail-loud) ---
    CheckBacklog [shape=parallelogram,
        tool_command=": \"${SOURCE_PATH:?set SOURCE_PATH}\" \"${TARGET_PATH:?set TARGET_PATH}\" \"${TARGET_KIND:?set TARGET_KIND}\" \"${FORGE_TOOL:?set FORGE_TOOL}\" \"${LEDGER_TOOL:?set LEDGER_TOOL}\" \"${BACKLOG:?set BACKLOG}\"; cd \"$TARGET_PATH\" && test \"$(LEDGER_FILE=$BACKLOG python3 \"$LEDGER_TOOL\" earliest)\" = NONE && printf done || printf process"]

    // --- pick the NEXT story in sequence; load its story card ---
    SelectStory [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="In $TARGET_PATH run `LEDGER_FILE=$BACKLOG python3 \\\"$LEDGER_TOOL\\\" earliest` — it prints '<story-id> <title-slug>'. Find that story's card (its user story, acceptance criteria, source pointers, depends-on) in $TARGET_PATH/inventory/stories/*.md. Write TWO files under $TARGET_PATH/.ai/: (1) gm_current.md — the story card VERBATIM (story, Given/When/Then acceptance, source pointers); (2) gm_current.env — exactly one line `STORY=<story-id>`. Delete .ai/gm_retries if present. $goal"]

    // --- fresh per-story branch in the target (deterministic) ---
    BranchSetup [shape=parallelogram,
        tool_command="cd \"$TARGET_PATH\" && set -a && . .ai/gm_current.env && set +a && rm -f .ai/gm_retries && git stash -q --include-untracked -- ':!.ai' 2>/dev/null; git checkout -q main && git pull -q --ff-only 2>/dev/null; git checkout -q -B gm/$STORY; printf ready"]

    // --- study how the SOURCE implements this story (deep read IS the job here) ---
    StudySource [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read $TARGET_PATH/.ai/gm_current.md. In $SOURCE_PATH, study how the source implements this story — follow its source pointers into the real code, and where UX matters boot the source app via $FORGE_TOOL to observe live behavior. Write $TARGET_PATH/.ai/gm_source.md: the behavior to preserve (states, edge cases, error paths, exact user-visible strings/layout where the acceptance depends on them), the source's data/flow structure, and which parts are language-idiom noise to DISCARD (do not carry source idioms into the target). Never edit the source. $goal"]

    // --- design the idiomatic target implementation + author acceptance tests FIRST ---
    PlanPort [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read .ai/gm_current.md, .ai/gm_source.md, and the target repo's conventions ($TARGET_PATH AGENTS.md / architecture / migration docs if present). Design the IDIOMATIC target-language implementation: exact files, the target-native primitives to use, and how earlier migrated stories are reused (respect the backlog sequence — dependencies are already migrated). Turn EVERY Given/When/Then acceptance criterion into a concrete target-language test you will add. Write the plan to .ai/gm_plan.md. THEN author the forge probe to .ai/gm_forge_check.sh: bash using $FORGE_TOOL (env $FORGE) that boots the REAL migrated target app and asserts the acceptance criteria from screen/grep; exit 0 on success. If the target repo is new and has no CI gate yet, the plan's first item is scaffolding ./ci/gate.sh + the CI workflow (gate == CI from story #1). $goal"]

    // --- implement the vertical slice in the TARGET language ---
    Implement [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="Read .ai/gm_plan.md (including any appended 'Fix N' sections). Implement the VERTICAL SLICE in $TARGET_PATH on the current branch — idiomatic target-language feature code + the acceptance tests from the plan + the forge probe + CI parity, together in one pass. Preserve the behavior recorded in .ai/gm_source.md; discard source-language idioms. Never edit $SOURCE_PATH. Do NOT run the suites yourself — the next node does. Append files changed to .ai/gm_impl.log. $goal"]

    // --- deterministic gate 1: target unit suite by kind (== CI) ---
    UnitValidate [shape=parallelogram,
        tool_command="cd \"$TARGET_PATH\" && set -a && . .ai/gm_current.env && set +a; case \"$TARGET_KIND\" in python) uv run ruff check . && uv run ruff format --check . && uv run pyright src/ && uv run pytest -q;; rust) cargo test --quiet && cargo clippy --all-targets --quiet -- -D warnings;; new:*) ./ci/gate.sh;; *) echo \"unknown kind $TARGET_KIND\" >&2; false;; esac >/tmp/gm_gate 2>&1 && printf pass || printf fail"]

    // --- deterministic gate 2: acceptance criteria through the real terminal (forge) ---
    ForgeValidate [shape=parallelogram,
        tool_command="cd \"$TARGET_PATH\" && export FORGE=\"$FORGE_TOOL\" && python3 \"$FORGE\" doctor >/tmp/gm_forge_doctor 2>&1 && bash .ai/gm_forge_check.sh >/tmp/gm_forge 2>&1 && printf pass || printf fail"]

    // --- diagnose a failing gate; append a concrete fix ---
    AnalyzeFailure [shape=box, llm_provider="anthropic", llm_model="claude-opus-4-8",
        prompt="A validation gate failed. Read /tmp/gm_gate, /tmp/gm_forge, /tmp/gm_forge_doctor and .ai/gm_impl.log. Diagnose the root cause and append a numbered 'Fix N' section to .ai/gm_plan.md with concrete, minimal changes. If the failure reveals the ACCEPTANCE CRITERIA were wrong or untestable (an inventory defect, not a code defect), say so explicitly and write a PROPOSAL to .ai/gm_amendment_proposals/<story-id>.md — NEVER edit inventory/stories/ from this loop; only the blind verifier (pipelines/verify.dot) or a human may accept an amendment (the rubric must not be mutable by the flow it grades). Do not edit source here — Implement applies the fix. Known flake: forge screen-scrape is timing-sensitive under load; if the ONLY failure is a forge assertion, say 're-run to confirm'. $goal"]

    // --- bound the fix loop at 3 (own counter; orthogonal to engine default_max_retry) ---
    RetryGate [shape=parallelogram,
        tool_command="cd \"$TARGET_PATH\" && n=$(cat .ai/gm_retries 2>/dev/null || echo 0); n=$((n+1)); echo $n > .ai/gm_retries; test $n -le 3 && printf retry || printf giveup"]

    // --- converged: commit + PR, mark implemented ---
    Commit [shape=parallelogram,
        tool_command="cd \"$TARGET_PATH\" && set -a && . .ai/gm_current.env && set +a && git add -A -- ':!.ai' ':!*.pyc' ':!__pycache__' && git commit -q -m \"feat(gm): $STORY\" && git push -q -u origin HEAD && gh pr create --fill --base main --head gm/$STORY --label gene-migration >/tmp/gm_pr 2>&1; LEDGER_FILE=$BACKLOG python3 \"$LEDGER_TOOL\" update $STORY implemented >/dev/null && printf next"]

    // --- could not converge: hand back to a human, keep the sequence moving ---
    MarkBlocked [shape=parallelogram,
        tool_command="cd \"$TARGET_PATH\" && set -a && . .ai/gm_current.env && set +a && mkdir -p .ai/gm_blocked && cp .ai/gm_plan.md .ai/gm_blocked/$STORY.md 2>/dev/null; LEDGER_FILE=$BACKLOG python3 \"$LEDGER_TOOL\" update $STORY acknowledged >/dev/null && git checkout -q main; printf next"]

    exit [shape=Msquare]

    // --- flow ---
    start -> CheckBacklog
    CheckBacklog -> exit        [condition="context.tool.last_line=done"]
    CheckBacklog -> SelectStory [condition="context.tool.last_line=process"]

    SelectStory -> BranchSetup
    BranchSetup -> StudySource
    StudySource -> PlanPort
    PlanPort -> Implement
    Implement -> UnitValidate

    UnitValidate  -> ForgeValidate  [condition="context.tool.last_line=pass"]
    UnitValidate  -> AnalyzeFailure [condition="context.tool.last_line=fail"]
    ForgeValidate -> Commit         [condition="context.tool.last_line=pass"]
    ForgeValidate -> AnalyzeFailure [condition="context.tool.last_line=fail"]

    AnalyzeFailure -> RetryGate
    RetryGate -> Implement   [condition="context.tool.last_line=retry"]
    RetryGate -> MarkBlocked [condition="context.tool.last_line=giveup"]

    Commit      -> CheckBacklog [loop_restart="true"]
    MarkBlocked -> CheckBacklog [loop_restart="true"]
}
